VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Canonical public domain. Auth confirmation / password-reset links redirect
# here (not window.location.origin) so they never point at a protected
# *.vercel.app deployment. Defaults to https://toledolokal.com if unset.
VITE_SITE_URL="https://toledolokal.com"

# Set ANTHROPIC_API_KEY in Supabase secrets (not here — this is for edge functions)
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
