VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Canonical public domain. Auth confirmation / password-reset links redirect
# here (not window.location.origin) so they never point at a protected
# *.vercel.app deployment. Defaults to https://toledolokal.com if unset.
VITE_SITE_URL="https://toledolokal.com"

# Google Maps JavaScript API key, used by the food-truck map, Near Me, and
# business-location maps. This key is public by design — lock it down with an
# HTTP-referrer restriction (your domain) in the Google Cloud console. When set,
# maps render with no login required. If left unset, the app falls back to the
# `get-maps-key` edge function (which needs GOOGLE_MAPS_API_KEY set in Supabase
# secrets and only serves signed-in users).
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-browser-key"

# Set ANTHROPIC_API_KEY in Supabase secrets (not here — this is for edge functions)
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
